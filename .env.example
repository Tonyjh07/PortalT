# ============================================================
# PortalT 环境变量示例
# 复制为 .env 后按需修改
# ============================================================

# 数据库驱动与连接
# DB_DRIVER=postgres | sqlite（默认 sqlite，调试/部署无需外部服务）
DB_DRIVER=postgres
# postgres: 连接串；sqlite: 数据库文件路径（空则内存库）
DB_DSN=postgres://portalt:securepassword@localhost:5432/portalt?sslmode=disable
# 迁移脚本目录（sqlite 方言脚本位于其 sqlite/ 子目录）
DB_MIGRATIONS_DIR=migrations

# 数据库（旧变量，Phase 5 config 整合后废弃）
DB_HOST=postgres
DB_PORT=5432
DB_USER=portalt
DB_PASSWORD=securepassword
DB_NAME=portalt

# JWT
JWT_SECRET=your-super-secret-key-change-me
JWT_ACCESS_TTL=900          # 15分钟
JWT_REFRESH_TTL=604800      # 7天

# 虚拟化平台提供者：esxi | workstation | mock（默认 mock，无需真实环境）
VIRT_PROVIDER=mock
# 通用配置（优先级高于下方各平台的 VIRT_*_ 前缀变量；esxi 时 url 必填）
# VIRT_URL=
# VIRT_USERNAME=
# VIRT_PASSWORD=
# VIRT_INSECURE=
# esxi 提供者配置（VIRT_PROVIDER=esxi 时 url 必填）
VIRT_ESXI_URL=https://esxi.lan/sdk
VIRT_ESXI_USERNAME=root
VIRT_ESXI_PASSWORD=password
VIRT_ESXI_INSECURE=true
# ESXi Web 管理界面地址（iframe 嵌入用）。留空时从 VIRT_URL 自动推导
# （https://<esxi-host>/sdk → https://<esxi-host>/ui/）
# ESXI_WEB_URL=https://esxi.lan/ui/
# VMware Workstation 提供者配置（开发调试适配器，url 缺省 http://127.0.0.1:8697）
# 前置：以管理员身份运行 "C:\Program Files (x86)\VMware\VMware Workstation\vmrest.exe -C" 设置凭证，
#      再运行 vmrest.exe 启动服务（HTTPS 需 -c 证书 -k 私钥，自签时配 VIRT_WS_INSECURE=true）
# VIRT_WS_URL=http://127.0.0.1:8697
# VIRT_WS_USERNAME=user
# VIRT_WS_PASSWORD=pass
# VIRT_WS_INSECURE=false

# Guacamole 远程桌面隧道
# 推荐：guacd 原生隧道（Phase 8，服务端握手，连接参数取自 VM metadata guac.*）
# 留空则回退 GUAC_URL；两者均留空则 /api/v1/guac/ws/:vmId 返回 503
GUACD_URL=127.0.0.1:4822
# 旧模式：Guacamole Web 应用 WebSocket 代理（http/https 自动转 ws/wss）
GUAC_URL=http://guacamole:8080/guacamole/websocket-tunnel
GUAC_SECRET=guac-secret

# 管理员初始账号
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Caddy
DOMAIN=portal.yourlab.com
